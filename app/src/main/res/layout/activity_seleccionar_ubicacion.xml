<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".Mapas.SeleccionarUbicacionActivity">

    <!-- Toolbar -->

    <RelativeLayout
        android:id="@+id/toolbarRL"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        >
        <!-- Regresar a la vista anterior -->

        <ImageButton
            android:id="@+id/Ib_regresar"
            android:src="@drawable/icon_regresar"
            android:background="@drawable/flag_transparent"
            android:layout_centerVertical="true"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            />

        <TextView
            android:textStyle="bold"
            android:layout_centerInParent="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            />

        <!-- Activar el gps del dispositivo -->

        <ImageButton
            android:id="@+id/Ib_gps"
            android:src="@drawable/icon_gps"
            android:background="@drawable/flag_transparent"
            android:layout_alignParentEnd="true"
            android:padding="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

        <View
            android:layout_alignParentEnd="true"
            android:background="#ccc"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            />

    </RelativeLayout>

    <!-- Mapa de google -->

    <fragment
        android:id="@+id/MapFragment"
        android:layout_below="@+id/toolbarRL"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Boton para buscar la ubicacion -->

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbarRL"
        app:cardCornerRadius="8dp"
        app:cardUseCompatPadding="true"
        >

        <fragment
            android:id="@+id/autocomplete_fragment"
            android:name="com.google.android.libraries.places.widget.AutocompleteSupportFragment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/listoLl"
        android:orientation="vertical"
        android:layout_margin="10dp"
        android:layout_alignParentBottom="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <!-- Boton para mostrar la ubicacion del usuario -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardUseCompatPadding="true"
            app:cardCornerRadius="8dp"
            app:contentPadding="10dp">

            <TextView
                android:id="@+id/lugarSelecTv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Confirmar la ubicacion -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/Btn_listo"
            android:text="@string/txtConfirm"
            android:textAllCaps="true"
            app:cornerRadius="8dp"
            app:icon="@drawable/icon_check"
            app:iconGravity="textEnd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

    </LinearLayout>

</RelativeLayout>